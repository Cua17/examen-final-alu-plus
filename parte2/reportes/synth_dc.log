# ------------------------------------------------------------------
# 2. Restricciones de timing
# ------------------------------------------------------------------
# Periodo ajustado con datos reales de cada corrida:
#   20ns -> post-route slack -1.45ns (no cumple)
#   24ns -> post-route slack -0.01ns (practicamente al limite)
#   25ns -> post-route slack -0.03ns (peor que con 24ns -- place_opt/
#           route_opt de ICC2 optimizan para "cumplir justo", no para
#           maximizar margen, asi que subir de a poco no garantiza mas
#           margen real de forma proporcional)
# 30ns da margen amplio y deja de depender de ese comportamiento del
# optimizador cerca del limite.
set clk_val 40.0
40.0
set CLK_PORT clk
clk
create_clock -name clk -period $clk_val [get_ports $CLK_PORT]
1
set_clock_uncertainty -setup [expr {$clk_val * 0.10}] [get_clocks clk]
1
set_clock_transition  -max   [expr {$clk_val * 0.10}] [get_clocks clk]
1
set_clock_latency -source -max [expr {$clk_val * 0.05}] [get_clocks clk]
1
set_clock_latency        -max [expr {$clk_val * 0.03}] [get_clocks clk]
1
set data_inputs [remove_from_collection [all_inputs] [get_ports $CLK_PORT]]
{reset a_in[15] a_in[14] a_in[13] a_in[12] a_in[11] a_in[10] a_in[9] a_in[8] a_in[7] a_in[6] a_in[5] a_in[4] a_in[3] a_in[2] a_in[1] a_in[0] b_in[15] b_in[14] b_in[13] b_in[12] b_in[11] b_in[10] b_in[9] b_in[8] b_in[7] b_in[6] b_in[5] b_in[4] b_in[3] b_in[2] b_in[1] b_in[0] aluControl_in[2] aluControl_in[1] aluControl_in[0]}
set_input_delay  -max [expr {$clk_val * 0.4}]  -clock [get_clocks clk] $data_inputs
1
set_input_delay  -min [expr {$clk_val * 0.01}] -clock [get_clocks clk] $data_inputs
1
set_output_delay -max [expr {$clk_val * 0.5}]  -clock [get_clocks clk] [all_outputs]
1
set_output_delay -min [expr {$clk_val * 0.01}] -clock [get_clocks clk] [all_outputs]
1
set_load -max 0.04 [all_outputs]
1
set_false_path -from [get_ports reset]
1
group_path -name INREG      -from [all_inputs]
1
group_path -name REGOUT     -to   [all_outputs]
1
group_path -name FEEDTHROUGH -from [all_inputs] -to [all_outputs]
